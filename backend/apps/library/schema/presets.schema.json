{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "joineryType": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "base": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "floor",
            "suspended",
            "plinth"
          ]
        },
        "heightMm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "kind",
        "heightMm"
      ]
    },
    "handle": {
      "type": "string",
      "enum": [
        "touch",
        "bar",
        "profile",
        "cava",
        "knob"
      ]
    },
    "modules": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fraction": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "front": {
            "type": "string",
            "enum": [
              "open",
              "door1",
              "door2",
              "drawers"
            ]
          },
          "shelves": {
            "type": "integer",
            "minimum": 0,
            "maximum": 12
          },
          "drawers": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          }
        },
        "required": [
          "fraction",
          "front",
          "shelves",
          "drawers"
        ]
      }
    }
  },
  "required": [
    "id",
    "version",
    "name",
    "joineryType",
    "base",
    "handle",
    "modules"
  ]
}
