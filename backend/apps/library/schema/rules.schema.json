{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "sheet": {
      "type": "object",
      "properties": {
        "lengthMm": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "widthMm": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "lengthMm",
        "widthMm"
      ]
    },
    "bodyThicknessMm": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "back": {
      "type": "object",
      "properties": {
        "thicknessMm": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "recessMm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "thicknessMm",
        "recessMm"
      ]
    },
    "front": {
      "type": "object",
      "properties": {
        "thicknessMm": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "gapMm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "thicknessMm",
        "gapMm"
      ]
    },
    "shelfFrontSetbackMm": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "hinges": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "maxDoorHeightMm": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "count": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "maxDoorHeightMm",
          "count"
        ]
      }
    },
    "minClearWidthMm": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "doorWidthToleranceMm": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "id",
    "version",
    "name",
    "sheet",
    "bodyThicknessMm",
    "back",
    "front",
    "shelfFrontSetbackMm",
    "hinges",
    "minClearWidthMm",
    "doorWidthToleranceMm"
  ]
}
