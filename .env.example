# Copie para .env e ajuste. O docker compose lê este arquivo automaticamente.
# Os valores abaixo são só para DESENVOLVIMENTO.

POSTGRES_DB=prancheta
POSTGRES_USER=prancheta
POSTGRES_PASSWORD=prancheta

DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_SETTINGS_MODULE=config.settings.dev

# S3 local (SeaweedFS). As credenciais precisam bater com docker/seaweedfs/s3.json.
S3_BUCKET=prancheta
S3_ACCESS_KEY=prancheta
S3_SECRET_KEY=prancheta-dev-secret
# Endereço do S3 visto pelo NAVEGADOR nas URLs pré-assinadas (upload/download direto).
# Em dev, "same-origin": o Vite repassa /<bucket>/ ao SeaweedFS (sem CORS). Em produção, a URL
# pública do S3/CDN.
# S3_PUBLIC_ENDPOINT_URL=same-origin

# Cadastro aberto (cria conta + escritório). Desligar em produção (convites na Fase 10).
# ALLOW_SIGNUP=true
