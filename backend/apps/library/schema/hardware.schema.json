{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "kind": {
      "type": "string",
      "enum": [
        "dobradica",
        "corredica",
        "fecho-toque",
        "articulador",
        "cesto",
        "outro"
      ]
    },
    "manufacturer": {
      "type": "string",
      "maxLength": 120
    },
    "code": {
      "type": "string",
      "maxLength": 60
    },
    "notes": {
      "type": "string",
      "maxLength": 500
    }
  },
  "required": [
    "id",
    "version",
    "name",
    "kind"
  ]
}
