# Copie para .env e ajuste. O docker compose lê este arquivo automaticamente.
# Os valores abaixo são só para DESENVOLVIMENTO.

POSTGRES_DB=prancheta
POSTGRES_USER=prancheta
POSTGRES_PASSWORD=prancheta

DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_SETTINGS_MODULE=config.settings.dev

# S3 local (SeaweedFS). As credenciais precisam bater com docker/seaweedfs/s3.json.
S3_BUCKET=prancheta
S3_ACCESS_KEY=prancheta
S3_SECRET_KEY=prancheta-dev-secret
